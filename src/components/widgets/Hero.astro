---

<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 bg-surface overflow-hidden">
  <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    
    <div class="relative z-10">
      <span class="inline-block font-sans text-xs font-bold uppercase tracking-[0.4em] text-primary mb-6">
        Estética & Bienestar
      </span>
      <h1 class="font-serif text-5xl md:text-7xl text-on-surface leading-[1.1] mb-8">
        El arte de <br/> <span class="italic font-light text-primary">cuidar de ti.</span>
      </h1>
      <p class="font-sans text-lg md:text-xl text-on-surface-variant leading-relaxed mb-10 max-w-md">
        Un refugio de serenidad donde cada detalle está diseñado para resaltar tu elegancia natural.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#servicios" class="px-8 py-4 bg-primary text-on-primary rounded-md font-sans font-semibold text-sm uppercase tracking-widest text-center hover:bg-primary/90 transition-colors">
          Explorar Servicios
        </a>
        <a href="#contacto" class="px-8 py-4 border border-outline text-on-surface rounded-md font-sans font-semibold text-sm uppercase tracking-widest text-center hover:bg-surface-container transition-colors">
          Ubicación
        </a>
      </div>
    </div>

    <div class="relative group">
      <div class="absolute -top-10 -right-10 w-64 h-64 bg-primary-container/40 rounded-full blur-[80px] -z-10"></div>
      
      <div class="rounded-t-[12rem] rounded-b-xl overflow-hidden shadow-2xl transition-transform duration-1000 group-hover:scale-[1.01]">
        <img 
          src="https://images.unsplash.com/photo-1604654894610-df63bc536371?q=80&w=1000&auto=format&fit=crop" 
          alt="Manicura Minimalista" 
          class="w-full h-[500px] md:h-[650px] object-cover object-center"
        />
      </div>
    </div>
  </div>
</section>
