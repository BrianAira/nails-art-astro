---
const phone = "542622698336"; // Tu número real
const message = encodeURIComponent("Hola Brian! Vi tu web y quería consultar por un turno.");
const whatsappUrl = `https://wa.me/${phone}?text=${message}`;

// Coordenadas de ejemplo de Tunuyán (puedes buscar tu local exacto en Google Maps y sacar el src del iframe)
const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13344.382173907486!2d-69.023249!3d-33.585574!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x96796fe9549f7e5d%3A0xc391b1574d75d342!2sTunuy%C3%A1n%2C%20Mendoza!5e0!3m2!1ses!2sar!4v1700000000000!5m2!1ses!2sar";
---

<section id="contact" class="py-24 bg-surface-container-lowest">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <div>
        <span class="inline-block font-sans text-xs font-bold uppercase tracking-[0.4em] text-primary mb-6">Ubicación</span>
        <h2 class="font-serif text-4xl md:text-5xl text-on-surface mb-8 italic font-light">Donde la magia <br/> <span class="not-italic font-normal">sucede.</span></h2>
        
        <div class="space-y-6 mb-10">
          <div class="flex items-start gap-4">
            <span class="text-primary text-xl"></span>
            <p class="text-on-surface-variant font-sans">Pelegrini 123, Tunuyán, <br/> Valle de Uco, Mendoza.</p>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-primary text-xl"></span>
            <p class="text-on-surface-variant font-sans">Lun a Vie: 09:00 - 19:00 <br/> Sáb: 09:00 - 14:00</p>
          </div>
        </div>

        <a href={whatsappUrl} target="_blank" class="inline-flex items-center px-8 py-4 bg-primary text-on-primary rounded-full font-sans font-bold text-xs uppercase tracking-widest hover:shadow-xl hover:shadow-primary/30 transition-all">
          Agendar por WhatsApp
        </a>
      </div>

      <div class="h-[500px] rounded-[2rem] overflow-hidden shadow-2xl border border-outline-variant grayscale-[0.3] contrast-[0.9]">
        <iframe 
          src={mapEmbedUrl}
          class="w-full h-full"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

    </div>
  </div>
</section>