---
import '../styles/global.css';
import WhatsAppFab from '../components/shared/WhatsAppFab.astro';

interface Props{
    title:string;
    description?:string;
}

const {title, description="Expertos en Manicura y Rail Art en Tunuyan"}=Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>  
        <meta name="description" content={description}/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    </head>
    <body class="bg-[#FAFAFA] text-zinc-900 selection:bg-pink-100 antialiased">
        <slot/>
        <WhatsAppFab/>
    </body>
</html>