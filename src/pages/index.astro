---
import Layout from '../layouts/layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Hero from '../components/widgets/Hero.astro';
import { getCollection } from 'astro:content';
import ServiceCard from '../components/widgets/ServiceCard.astro';
import Footer from '../components/shared/Footer.astro';
import Gallery from '../components/widgets/Gallery.astro';
import About from '../components/widgets/About.astro';
import Contact from '../components/widgets/Contact.astro';
const todosLosServicios= await getCollection('services')
---

<Layout title='Nail Art Studio | Manicura y Estetica Profesional'
description='Reserva tu cita en el mejor estudio de manicura. Diseños exclusivos y cuidado premium para tus manos'
>
	<Navbar/>
	<main>
		<Hero/>
		<About id="about"/>
		<ServiceCard id="services"/>
		<Gallery id="lookbook"/>
		<Contact id="contact"/>

		
	</main>
	<Footer/>
</Layout>
